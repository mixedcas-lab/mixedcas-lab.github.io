---
import Layout from '../layouts/Layout.astro';
import PageHeading from '../components/PageHeading.astro';
import news from '../data/news.json';
const years=[...new Set(news.map(n=>n.date.slice(0,4)))];
---
<Layout title="News" dark><PageHeading label="News / Lab updates" title="Our story, in progress." description="Research milestones, awards and news from MCAS Lab." />
  <section class="section"><div class="container"><form class="filters" id="news-filters"><label>Search news<input type="search" id="news-search" placeholder="Award, research, people…" aria-label="Search news" /></label><label>Year<select id="news-year"><option value="all">All years</option>{years.map(y=><option>{y}</option>)}</select></label></form><p class="result-count" id="news-count" aria-live="polite">{news.length} updates</p>{news.map(n=><article class="news-row" data-news data-year={n.date.slice(0,4)} data-search={n.text.toLowerCase()}><time class="news-date" datetime={n.date}>{n.date.replace('-',' / ')}</time><span class="news-type">{n.category}</span><h3>{n.text.replace('(Link)','')}{n.url&&<a class="text-link" href={n.url}> Conference ↗</a>}</h3></article>)}<p id="news-empty" class="empty-state" hidden>No matching news. Try another search.</p></div></section>
</Layout>
