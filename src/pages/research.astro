---
import Layout from '../layouts/Layout.astro';
import PageHeading from '../components/PageHeading.astro';
import research from '../data/research.json';
import site from '../data/site.json';
---
<Layout title="Research" dark>
  <PageHeading label="Research" title="Research." description="Data converters and mixed-signal circuits for communication, sensing, memory and computing." />
  <section class="section"><div class="container"><div class="research-overview"><h2>Overview.</h2><p>{site.description}</p></div>
  {research.map((r,i)=><article class="research-block" id={r.id}><span class="large-no">0{i+1}</span><div><span class="eyebrow">{r.tag}</span><h2>{r.title}</h2></div><div><p>{r.description}</p><small>{r.originalTitle}</small></div></article>)}
  <div class="subsection" id="chips"><span class="eyebrow">Chip micrographs</span><h2 style="margin-top:16px">Chips.</h2><p>Chips designed and measured at MCAS Lab.</p><figure class="full-chip feature-chip"><img src="../images/chip-tisar-28nm.jpg" width="1600" height="741" alt="Die photo of a 7-bit 32-GS/s time-interleaved SAR ADC in 28-nm CMOS" loading="lazy" /><figcaption>7-bit 32-GS/s time-interleaved SAR ADC · 28-nm CMOS · core 522 µm × 423 µm</figcaption></figure><figure class="full-chip"><a href="../images/chips.png" target="_blank" rel="noopener" aria-label="Open full chip photograph"><img src="../images/chips.png" width="1280" height="545" alt="Chip photograph collection: touch pen, 3D touch, sensor, biomedical and 5G wireless communication circuits" loading="lazy" /></a><figcaption>Select the image to view it at full size.</figcaption></figure></div>
  <div class="button-row"><a class="button" href="../publications/">Publications →</a><a class="button button-outline" href="../people/">People →</a></div></div></section>
</Layout>
