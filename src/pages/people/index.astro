---
import Layout from '../../layouts/Layout.astro';
import PageHeading from '../../components/PageHeading.astro';
import professor from '../../data/professor.json';
import site from '../../data/site.json';
const r = '../';
---
<Layout title="People" dark><PageHeading label="People" title="People." description="Faculty and students of MCAS Lab at the University of Seoul." />
  <nav class="people-tabs container" aria-label="People sections"><a href={`${r}people/`} aria-current="page">Principal Investigator</a><a href={`${r}people/members/`}>Members</a></nav>
  <section class="section"><div class="container"><div class="professor-intro" id="professor"><div class="professor-portrait"><img src={`../${professor.image}`} alt="Professor Min-Jae Seo" width="480" height="600" /></div><div><span class="eyebrow"><span class="small-dot"></span>Principal investigator</span><h2>{professor.name}, <span style="font-size:.55em">{professor.suffix}</span></h2><p class="role">{professor.role}</p><p>{site.school}<br/>{site.university}</p><a class="text-link" href={`mailto:${professor.email}`}>{professor.email} ↗</a></div></div>
  <div class="cv-grid"><div class="cv-column"><h3>Education</h3>{professor.education.map(e=><article class="cv-entry"><span>{e.period}</span><h4>{e.title}</h4><p>{e.institution}</p><small>{e.note}</small></article>)}<div class="subsection"><h3>Awards & honors</h3>{professor.awards.map(a=><article class="cv-entry"><span>{a.year}</span><h4>{a.title}</h4><p>{a.detail}</p></article>)}</div></div><div class="cv-column"><h3>Experience</h3>{professor.experience.map(e=><article class="cv-entry"><span>{e.period}</span><h4>{e.title}</h4><p>{e.institution}</p></article>)}<div class="subsection"><h3>Academic service</h3><ul class="cv-list">{professor.activities.map(a=><li>{a}</li>)}</ul></div></div></div>
</div></section>
</Layout>
