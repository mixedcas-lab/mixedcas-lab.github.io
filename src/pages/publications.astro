---
import Layout from '../layouts/Layout.astro';
import PageHeading from '../components/PageHeading.astro';
import Paper from '../components/Paper.astro';
import papers from '../data/publications.json';
import patents from '../data/patents.json';
const listed=papers.filter(p=>p.status!=='In preparation');
const preparing=papers.filter(p=>p.status==='In preparation');
const years=[...new Set(listed.map(p=>p.year).filter(Boolean))].sort((a,b)=>Number(b)-Number(a));
---
<Layout title="Publications" dark><PageHeading label="Publications" title="Publications." description="Journal articles, conference papers and manuscripts. * indicates the corresponding author." />
  <section class="section"><div class="container">{preparing.length>0&&<section class="prep-block" id="in-preparation"><span class="eyebrow">Upcoming</span><h2 style="margin-top:15px">In preparation.</h2><div class="prep-list">{preparing.map(p=><article class="paper prep"><div class="paper-index">—</div><div class="paper-main"><div class="paper-meta"><span>{p.venue}</span><span>{p.kind}</span><span class="status">To be submitted</span></div><h3>{p.title}</h3><p>{p.details}</p></div><span aria-hidden="true"></span></article>)}</div></section>}<form class="filters" role="search" id="paper-filters"><label>Search publications<input id="paper-search" type="search" placeholder="Title, author or venue…" aria-label="Search publications" /></label><label>Year<select id="paper-year"><option value="all">All years</option>{years.map(y=><option value={String(y)}>{y}</option>)}{listed.some(p=>!p.year)&&<option value="unknown">Not specified</option>}</select></label><label>Type<select id="paper-kind"><option value="all">All publications</option><option>Journal</option><option>Conference</option></select></label></form><p class="result-count" id="paper-count" aria-live="polite">{listed.length} publications</p><div id="paper-list">{listed.map(paper=><Paper paper={paper} />)}</div><p class="empty-state" id="paper-empty" hidden>No matching publications. Try another title, author or year.</p><noscript><p>All publications are shown. Enable JavaScript to use search and filters.</p></noscript>
  <section class="subsection" id="patents"><span class="eyebrow">Intellectual property</span><h2 style="margin-top:15px">Patents.</h2><div class="patent-grid">{patents.map(p=><article class="patent"><h3>{p.title}</h3>{p.details.map(d=><p>{d}</p>)}</article>)}</div></section></div></section>
</Layout>
