---
import site from '../data/site.json';
import { relativeRoot } from '../lib/paths';
import news from '../data/news.json';
const { title = '', description = site.description, dark = false, rootOverride } = Astro.props;
const root = rootOverride || relativeRoot(Astro.url.pathname);
const nav = [['Research','research'],['People','people'],['Publications','publications'],['Gallery','gallery'],['News','news']];
const latest = news[0];
const current = Astro.url.pathname.split('/').filter(Boolean)[0] || '';
const canonical = process.env.SITE_URL ? process.env.SITE_URL.replace(/\/$/,'') + Astro.url.pathname : undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#09182c" />
    <meta property="og:title" content={title ? `${title} — MCAS Lab` : 'MCAS Lab — University of Seoul'} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/png" href={`${root}${site.logos.light}`} />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=IBM+Plex+Mono:wght@400;500&display=swap" />
    <link rel="stylesheet" href={`${root}styles.css`} />
    <title>{title ? `${title} — MCAS Lab` : 'MCAS Lab — University of Seoul'}</title>
    <script is:inline src={`${root}site.js`} defer></script>
  </head>
  <body class:list={{ 'dark-header':dark }}>
    <a class="skip-link" href="#main">Skip to content</a>
    {latest && <a class="announce" href={`${root}news/`}><span class="container announce-inner"><span class="announce-date">{latest.date.replace('-','.')}</span><span class="announce-text">{latest.text}</span><span class="announce-more">All news <span aria-hidden="true">→</span></span></span></a>}
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href={root} aria-label="MCAS Lab home"><img class="brand-logo" src={`${root}${dark ? site.logos.dark : site.logos.light}`} alt="MCAS Lab — Mixed-Signal Circuits and Systems" width="3508" height="610" /></a>
        <button class="menu-toggle" aria-controls="primary-nav" aria-expanded="false"><span>Menu</span><span class="menu-lines" aria-hidden="true"></span></button>
        <nav id="primary-nav" aria-label="Main navigation">
          {nav.map(([label,path])=><a href={`${root}${path}/`} aria-current={current===path?'page':undefined}>{label}</a>)}
          <a class="nav-contact" href={`${root}contact/`}>Contact <span aria-hidden="true">→</span></a>
        </nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="container footer-top">
        <div><a class="footer-logo" href={root} aria-label="MCAS Lab home"><img src={`${root}${site.logos.dark}`} alt="MCAS Lab — Mixed-Signal Circuits and Systems" width="3508" height="610" loading="lazy" /></a><p>{site.fullName}</p></div>
        <div><span class="eyebrow">University of Seoul</span><p>School of Advanced Fusion Studies<br/>Natural Science Building · Room 305</p><a href={`mailto:${site.email}`}>{site.email} ↗</a></div>
        <div class="footer-links"><a href={`${root}teaching/`}>Teaching</a><a href={`${root}publications/#patents`}>Patents</a><a href={`${root}contact/`}>Contact</a></div>
      </div>
      <div class="container footer-bottom"><span>© {new Date().getFullYear()} MCAS Lab. University of Seoul.</span><span>University of Seoul · School of Advanced Fusion Studies</span><a href="#main">Back to top ↑</a></div>
    </footer>
  </body>
</html>
