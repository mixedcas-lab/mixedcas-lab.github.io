---
// Animated mixed-signal chain: analog sine -> ADC -> digital codes -> DAC -> reconstructed sine.
const mid = 200, amp = 52, period = 120, ts = 15;
const sine = (x0: number, x1: number) => {
  const pts: string[] = [];
  for (let x = x0; x <= x1; x += 2) pts.push(`${x},${(mid - amp * Math.sin((2 * Math.PI * x) / period)).toFixed(1)}`);
  return 'M' + pts.join(' L');
};
const stairs = (x0: number, x1: number) => {
  let d = '';
  for (let x = x0; x < x1; x += ts) {
    const y = (mid - amp * Math.sin((2 * Math.PI * x) / period)).toFixed(1);
    d += (d ? ` L${x},${y}` : `M${x},${y}`) + ` L${x + ts},${y}`;
  }
  return d;
};
const dots = (x0: number, x1: number) => {
  const out: [number, number][] = [];
  for (let x = x0; x <= x1; x += ts) out.push([x, mid - amp * Math.sin((2 * Math.PI * x) / period)]);
  return out;
};
const clock = (x0: number, x1: number) => {
  let d = `M${x0},352`;
  for (let x = x0; x < x1; x += ts) d += ` L${x},340 L${x + ts / 2},340 L${x + ts / 2},352 L${x + ts},352`;
  return d;
};
// 4-bit codes of the sampled sine, one column per sample
const codes = Array.from({ length: 16 }, (_, i) => Math.round(7.5 + 7.5 * Math.sin((2 * Math.PI * i * ts) / period)));
const bits = codes.flatMap((c, i) => [3, 2, 1, 0].map(b => ({ x: i * 14, y: 158 + (3 - b) * 22, on: (c >> b) & 1 })));
---
<svg class="signal-chain" viewBox="0 0 640 400" role="img" aria-label="An analog sine wave is sampled by an ADC, carried as digital codes, and reconstructed by a DAC">
  <defs>
    <clipPath id="sc-in"><rect x="24" y="100" width="150" height="200" /></clipPath>
    <clipPath id="sc-bits"><rect x="288" y="140" width="66" height="110" /></clipPath>
    <clipPath id="sc-out"><rect x="466" y="100" width="150" height="200" /></clipPath>
    <clipPath id="sc-clk"><rect x="196" y="330" width="250" height="30" /></clipPath>
    <linearGradient id="sc-fade-l" x1="0" x2="1"><stop offset="0" stop-color="#09182c" /><stop offset="1" stop-color="#09182c" stop-opacity="0" /></linearGradient>
    <linearGradient id="sc-fade-r" x1="1" x2="0"><stop offset="0" stop-color="#09182c" /><stop offset="1" stop-color="#09182c" stop-opacity="0" /></linearGradient>
  </defs>

  <g class="sc-labels">
    <text x="24" y="78">ANALOG IN</text>
    <text x="321" y="78" text-anchor="middle">DIGITAL</text>
    <text x="616" y="78" text-anchor="end">ANALOG OUT</text>
  </g>
  <line class="sc-axis" x1="24" y1={mid} x2="174" y2={mid} />
  <line class="sc-axis" x1="466" y1={mid} x2="616" y2={mid} />

  <g clip-path="url(#sc-in)">
    <g class="sc-move">
      <path class="sc-wave" d={sine(-240, 300)} />
      {dots(-240, 300).map(([x, y]) => <circle class="sc-dot" cx={x} cy={y} r="2.6" />)}
    </g>
  </g>
  <rect x="24" y="100" width="34" height="200" fill="url(#sc-fade-l)" />

  <path class="sc-wire" d="M174,200 L196,200" />
  <g class="sc-block">
    <rect x="196" y="140" width="84" height="120" rx="6" />
    <text x="238" y="206" text-anchor="middle">ADC</text>
    <path class="sc-icon" d="M214,236 h10 v-6 h10 v-6 h10 v-6 h10 v-6 h8" />
  </g>

  <g clip-path="url(#sc-bits)">
    <g class="sc-move-bits">
      {[0, 224].map(o => bits.map(b => <rect class={b.on ? 'sc-bit on' : 'sc-bit'} x={288 - 224 + o + b.x} y={b.y} width="9" height="14" rx="1.5" />))}
    </g>
  </g>

  <path class="sc-wire" d="M354,200 L362,200" />
  <g class="sc-block">
    <rect x="362" y="140" width="84" height="120" rx="6" />
    <text x="404" y="206" text-anchor="middle">DAC</text>
    <path class="sc-icon" d="M380,236 h8 v-6 h10 v-6 h10 v-6 h10 v-6 h10" />
  </g>
  <path class="sc-wire" d="M446,200 L466,200" />

  <g clip-path="url(#sc-out)">
    <g class="sc-move">
      <path class="sc-ghost" d={sine(226, 760)} />
      <path class="sc-stairs" d={stairs(226, 760)} />
    </g>
  </g>
  <rect x="582" y="100" width="34" height="200" fill="url(#sc-fade-r)" />

  <g class="sc-clock">
    <text x="196" y="324">CLK</text>
    <g clip-path="url(#sc-clk)"><g class="sc-move-clk"><path d={clock(166, 470)} /></g></g>
  </g>
</svg>
