---
// Animated mixed-signal chain: analog sine -> ADC -> digital codes -> DAC -> reconstructed sine.
// "wide" is the full-width desktop banner; "compact" is the stacked mobile version.
const { layout = 'wide' } = Astro.props;
const L = layout === 'wide'
  ? { W: 1200, H: 290, mid: 150, amp: 74, period: 160, ts: 20, labelY: 28, inX: [0, 392], adc: [416, 540], bits: [566, 698], dac: [724, 848], outX: [872, 1200], blockH: 88, clkY: 262, bitW: 11, bitH: 16, bitDx: 16, lane: 24 }
  : { W: 640, H: 300, mid: 150, amp: 52, period: 120, ts: 15, labelY: 40, inX: [16, 172], adc: [190, 290], bits: [306, 362], dac: [378, 478], outX: [494, 624], blockH: 74, clkY: 270, bitW: 9, bitH: 13, bitDx: 14, lane: 20 };
const { W, H, mid, amp, period, ts } = L;
const y = (x: number) => mid - amp * Math.sin((2 * Math.PI * x) / period);
const sine = (x0: number, x1: number) => {
  const pts: string[] = [];
  for (let x = x0; x <= x1; x += 2) pts.push(`${x},${y(x).toFixed(1)}`);
  return 'M' + pts.join(' L');
};
const stairs = (x0: number, x1: number) => {
  let d = '';
  for (let x = x0; x < x1; x += ts) d += `${d ? ' L' : 'M'}${x},${y(x).toFixed(1)} L${x + ts},${y(x).toFixed(1)}`;
  return d;
};
const samples = (x0: number, x1: number) => {
  const out: number[] = [];
  for (let x = x0; x <= x1; x += ts) out.push(x);
  return out;
};
const clock = (x0: number, x1: number) => {
  let d = `M${x0},${L.clkY + 10}`;
  for (let x = x0; x < x1; x += ts) d += ` L${x},${L.clkY} L${x + ts / 2},${L.clkY} L${x + ts / 2},${L.clkY + 10} L${x + ts},${L.clkY + 10}`;
  return d;
};
// Converter symbol: a box with a pointed output side, pointing along the signal flow.
const pent = ([x0, x1]: number[]) => {
  const t = 22, y0 = mid - L.blockH / 2, y1 = mid + L.blockH / 2;
  return `M${x0},${y0} L${x1 - t},${y0} L${x1},${mid} L${x1 - t},${y1} L${x0},${y1} Z`;
};
const period4 = Math.round(period / ts); // samples per sine period
const cols = period4 * 2;
const codes = Array.from({ length: cols }, (_, i) => Math.round(7.5 + 7.5 * Math.sin((2 * Math.PI * i) / period4)));
const unit = cols * L.bitDx;
const bitsTop = mid - (L.lane * 3 + L.bitH) / 2;
const bits = codes.flatMap((c, i) => [3, 2, 1, 0].map(b => ({ x: i * L.bitDx, y: bitsTop + (3 - b) * L.lane, on: (c >> b) & 1 })));
const id = `sc-${layout}`;
const [bx0, bx1] = L.bits;
---
<svg class={`signal-chain signal-${layout}`} viewBox={`0 0 ${W} ${H}`} style={`--p:${period}px;--u:${unit}px;--c:${ts}px`} role="img" aria-label="An analog sine wave is sampled by an ADC, carried as digital codes, and reconstructed by a DAC">
  <defs>
    <clipPath id={`${id}-in`}><rect x={L.inX[0]} y="0" width={L.inX[1] - L.inX[0]} height={H} /></clipPath>
    <clipPath id={`${id}-bits`}><rect x={bx0} y="0" width={bx1 - bx0} height={H} /></clipPath>
    <clipPath id={`${id}-out`}><rect x={L.outX[0]} y="0" width={L.outX[1] - L.outX[0]} height={H} /></clipPath>
    <clipPath id={`${id}-clk`}><rect x={L.adc[0]} y={L.clkY - 4} width={L.dac[1] - L.adc[0]} height="20" /></clipPath>
    <linearGradient id={`${id}-fl`} x1="0" x2="1"><stop offset="0" stop-color="#09182c" /><stop offset="1" stop-color="#09182c" stop-opacity="0" /></linearGradient>
    <linearGradient id={`${id}-fr`} x1="1" x2="0"><stop offset="0" stop-color="#09182c" /><stop offset="1" stop-color="#09182c" stop-opacity="0" /></linearGradient>
  </defs>

  <g class="sc-labels">
    <text x={(L.inX[0] + L.inX[1]) / 2} y={L.labelY} text-anchor="middle">ANALOG IN</text>
    <text x={(bx0 + bx1) / 2} y={L.labelY} text-anchor="middle">DIGITAL</text>
    <text x={(L.outX[0] + L.outX[1]) / 2} y={L.labelY} text-anchor="middle">ANALOG OUT</text>
  </g>
  <line class="sc-axis" x1={L.inX[0]} y1={mid} x2={L.inX[1]} y2={mid} />
  <line class="sc-axis" x1={L.outX[0]} y1={mid} x2={L.outX[1]} y2={mid} />

  <g clip-path={`url(#${id}-in)`}>
    <g class="sc-move">
      <path class="sc-wave" d={sine(L.inX[0] - 2 * period, L.inX[1] + 4)} />
      {samples(L.inX[0] - 2 * period, L.inX[1]).map(x => <circle class="sc-dot" cx={x} cy={y(x)} r={layout === 'wide' ? 3.2 : 2.6} />)}
    </g>
  </g>
  <rect x={L.inX[0]} y={L.labelY + 12} width="40" height={H - L.labelY - 12} fill={`url(#${id}-fl)`} />

  <path class="sc-wire" d={`M${L.inX[1]},${mid} L${L.adc[0]},${mid}`} />
  <g class="sc-block">
    <path d={pent(L.adc)} />
    <text x={(L.adc[0] + L.adc[1] - 8) / 2} y={mid + 8} text-anchor="middle">ADC</text>
  </g>
  <path class="sc-wire" d={`M${L.adc[1]},${mid} L${bx0},${mid}`} />

  <g clip-path={`url(#${id}-bits)`}>
    <g class="sc-move-bits">
      {[0, unit].map(o => bits.map(b => <rect class={b.on ? 'sc-bit on' : 'sc-bit'} x={bx0 - unit + o + b.x} y={b.y} width={L.bitW} height={L.bitH} rx="1.5" />))}
    </g>
  </g>

  <path class="sc-wire" d={`M${bx1},${mid} L${L.dac[0]},${mid}`} />
  <g class="sc-block">
    <path d={pent(L.dac)} />
    <text x={(L.dac[0] + L.dac[1] - 8) / 2} y={mid + 8} text-anchor="middle">DAC</text>
  </g>
  <path class="sc-wire" d={`M${L.dac[1]},${mid} L${L.outX[0]},${mid}`} />

  <g clip-path={`url(#${id}-out)`}>
    <g class="sc-move">
      <path class="sc-ghost" d={sine(L.outX[0] - 2 * period, L.outX[1] + 4)} />
      <path class="sc-stairs" d={stairs(L.outX[0] - 2 * period, L.outX[1] + ts)} />
    </g>
  </g>
  <rect x={L.outX[1] - 40} y={L.labelY + 12} width="40" height={H - L.labelY - 12} fill={`url(#${id}-fr)`} />

  <g class="sc-clock">
    <text x={L.adc[0] - 10} y={L.clkY + 9} text-anchor="end">CLK</text>
    <g clip-path={`url(#${id}-clk)`}><g class="sc-move-clk"><path d={clock(L.adc[0] - 2 * ts, L.dac[1] + ts)} /></g></g>
  </g>
</svg>
